# systemd --user unit. Install:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/tab-relay.service ~/.config/systemd/user/
#   # edit WorkingDirectory below if the repo is not in ~/Projects/tab-relay
#   systemctl --user daemon-reload
#   systemctl --user enable --now tab-relay
#   loginctl enable-linger "$USER"   # keep running when logged out (may need an admin if it's restricted)
[Unit]
Description=Tab Relay server
After=network-online.target

[Service]
WorkingDirectory=%h/Projects/tab-relay/server
ExecStart=/usr/bin/env node src/index.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
